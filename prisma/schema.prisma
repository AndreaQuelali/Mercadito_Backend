// Prisma schema for Mercadito Backend
// Provider: PostgreSQL
// Docs: https://www.prisma.io/docs

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Category {
  verduras
  frutas
  panaderia
  lacteos
  artesanias
}

enum Unit {
  kilogramo
  unidad
  frasco
  litro
}

enum UserRole {
  admin
  user
}

enum SellerStatus {
  active
  suspended
}

model User {
  id               String   @id @default(uuid())
  firstName        String
  lastName         String
  phoneNumber      String
  phoneCountryCode String
  country          String
  city             String
  email            String   @unique
  role             UserRole @default(user)
  password         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  carts   Cart[]
  orders  Order[]
  reviews       Review[]
  seller        Seller?
  notifications Notification[]
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    String
  type      String // order:status | order:new | stock:low | review:new
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Seller {
  id           String       @id @default(uuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  description  String?
  avatarUrl    String?
  location     String?
  status       SellerStatus @default(active)
  // Which seller events to receive ("order:new" | "stock:low" | "review:new" -> boolean). null = all on
  notificationPrefs Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Decimal  @db.Decimal(10, 2)
  stock       Int
  unit        Unit
  category    Category
  description String
  image       String
  sellerId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  seller     Seller    @relation(fields: [sellerId], references: [id])
  embedding  ProductEmbedding?
}

/// One vector per product. Written and read only with raw SQL (Prisma cannot map `vector`).
model ProductEmbedding {
  productId   Int                          @id
  product     Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  embedding   Unsupported("vector(1024)")
  /// sha256 of the indexed text; unchanged text is not re-embedded
  contentHash String
  /// e.g. "voyage-3.5-lite"; a different model forces a reindex
  model       String
  updatedAt   DateTime                     @updatedAt
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    String   @unique // One active cart per user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

enum OrderStatus {
  pending
  paid
  confirmed
  shipped
  delivered
  cancelled
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    String
  status    OrderStatus @default(pending)
  total     Decimal     @default(0) @db.Decimal(10, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal  @db.Decimal(10, 2) // price at purchase time
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    String
  productId Int
  rating    Int // 1..5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}
