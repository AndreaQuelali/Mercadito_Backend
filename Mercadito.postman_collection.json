            },
            "url": {
              "raw": "{{API_URL}}/cart/item/:itemId",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "cart",
                "item",
                ":itemId"
              ],
              "variable": [
                {
                  "key": "itemId",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "List my purchases",
          "request": {
