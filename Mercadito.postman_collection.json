              "raw": "{{API_URL}}/seller/:id/status",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "seller",
                ":id",
                "status"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "00000000-0000-0000-0000-000000000000"
                }
              ]
            }
          }
        }
      ]
