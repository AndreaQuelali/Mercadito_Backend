{
  "info": {
    "name": "Mercadito",
    "description": "REST API of Mercadito, a marketplace for local products.\n\nAuthenticate with `POST /auth/login`, then send the access token as `Authorization: Bearer <token>`. It lasts 15 minutes; renew it with `POST /auth/refresh`.\n\nReal-time notifications use Socket.IO (see the README); their history is under `/notification`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "API_URL",
      "value": "http://localhost:3000"
    },
    {
      "key": "TOKEN",
      "value": ""
    },
    {
      "key": "REFRESH_TOKEN",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{API_URL}}/health",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register a new account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ana\",\n  \"lastName\": \"Quispe\",\n  \"email\": \"ana@example.com\",\n  \"password\": \"Secreto#123\",\n  \"phoneNumber\": \"71234567\",\n  \"phoneCountryCode\": \"+591\",\n  \"country\": \"Bolivia\",\n  \"city\": \"La Paz\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{API_URL}}/auth/register",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Log in",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\",\n  \"password\": \"Secreto#123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{API_URL}}/auth/login",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Returns a 15 minute access token and a refresh token (7 days, single use).",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.token) {",
                  "  pm.collectionVariables.set(\"TOKEN\", body.data.token);",
                  "  pm.collectionVariables.set(\"REFRESH_TOKEN\", body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Renew the session",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{API_URL}}/auth/refresh",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            },
            "description": "Consumes the refresh token and returns a new access token plus a new refresh token. Using an already used refresh token revokes the whole session. A 500 means a temporary failure: keep the current session and retry.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body && body.data && body.data.token) {",
                  "  pm.collectionVariables.set(\"TOKEN\", body.data.token);",
                  "  pm.collectionVariables.set(\"REFRESH_TOKEN\", body.data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Log out (revoke the session)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{REFRESH_TOKEN}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{API_URL}}/auth/logout",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Idempotent: it succeeds even if the refresh token was already revoked.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Request a password reset email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{API_URL}}/auth/password/forgot",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "auth",
                "password",
                "forgot"
              ]
            },
            "description": "Always answers 200 so the existence of an email is not disclosed.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Set a new password with a reset token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"3f9a...c2\",\n  \"newPassword\": \"NuevoSecreto#456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{API_URL}}/auth/password/reset",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "auth",
                "password",
                "reset"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
