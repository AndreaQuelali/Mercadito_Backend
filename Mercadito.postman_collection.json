        {
          "name": "Search products (semantic + text)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{API_URL}}/product/search?q=&limit=&category=&includeOutOfStock=",
              "host": [
                "{{API_URL}}"
              ],
