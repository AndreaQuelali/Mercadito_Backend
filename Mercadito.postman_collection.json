            "description": "Refused with 409 while the seller still has products."
          }
        },
        {
          "name": "Get my notification settings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{API_URL}}/seller/notification-settings",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "seller",
                "notification-settings"
              ]
            },
            "description": "Which seller events I receive (`order:new`, `stock:low`, `review:new`; all on by default) and the low stock threshold, which the server defines (`LOW_STOCK_THRESHOLD`) and sellers cannot change."
          }
        },
        {
          "name": "Turn seller notifications on or off",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock:low\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{API_URL}}/seller/notification-settings",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "seller",
                "notification-settings"
              ]
            },
            "description": "Partial update: send only the events to change. A turned-off event is neither emitted over Socket.IO nor stored in the history. `order:status` is part of the order flow and cannot be turned off."
          }
        },
        {
          "name": "Sales summary of my store",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{API_URL}}/seller/sales?from=&to=",
              "host": [
                "{{API_URL}}"
              ],
              "path": [
                "seller",
                "sales"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "",
                  "disabled": true,
                  "description": "Start of the range, inclusive (default: no lower bound)"
                },
                {
                  "key": "to",
                  "value": "",
                  "disabled": true,
                  "description": "End of the range, inclusive. A plain date includes that whole day (default: no upper bound)"
                }
              ]
            },
            "description": "Revenue and units come from the seller's own items in orders that are `paid`, `confirmed`, `shipped` or `delivered`; `pending` and `cancelled` orders are not sales (they still show in `ordersByStatus`). The range filters by the creation date of the order. Without filters it covers all time."
          }
        },
        {
          "name": "Activate or suspend a seller",
          "request": {
            "method": "PATCH",
            "header": [
