PORT="3000"
POSTGRES_PASSWORD="your_password"
POSTGRES_USER="your_user"
POSTGRES_DB="your_db"
PGDATA="/var/lib/postgresql/data/pgdata"
PGHOST="localhost"
PGPORT="5433"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${PGHOST}:${PGPORT}/${POSTGRES_DB}?schema=public"
NODE_ENV="development"
JWT_SECRET="change_this_to_a_strong_random_secret"
PWD_SECRET="change_this_to_a_strong_random_secret"
# bcrypt rounds — valid range 1-31; 10 is recommended for production
SALTS="10"
REDIS_HOST="localhost"
REDIS_PORT="6379"
# Frontend origin for CORS — use * in dev, set exact origin in production
CORS_ORIGIN="http://localhost:4200"
# Base URL used to build password-reset links in emails
APP_URL="http://localhost:3000"
# SMTP settings — leave empty to fall back to console.log in development
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@mercadito.app"
