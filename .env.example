PORT="3000"
POSTGRES_PASSWORD="your_password"
POSTGRES_USER="your_user"
POSTGRES_DB="your_db"
PGDATA="/var/lib/postgresql/data/pgdata"
PGHOST="localhost"
PGPORT="5433"
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${PGHOST}:${PGPORT}/${POSTGRES_DB}?schema=public"
NODE_ENV="development"
JWT_SECRET="change_this_to_a_strong_random_secret"
PWD_SECRET="change_this_to_a_strong_random_secret"

SALTS="10"
REDIS_HOST="localhost"
REDIS_PORT="6379"

CORS_ORIGIN="http://localhost:4200"
APP_URL="http://localhost:4200"

SMTP_HOST="localhost"
SMTP_PORT="1027"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Mercadito <noreply@mercadito.app>"

LOW_STOCK_THRESHOLD=5
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_SECONDS=604800

ENABLE_DOCS=true

VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5-lite
SEARCH_MIN_SIMILARITY=0.35
SEARCH_RATE_LIMIT_PER_MIN=30

OPENAI_API_KEY=